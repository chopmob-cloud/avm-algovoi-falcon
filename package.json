{
  "name": "algovoi-falcon",
  "version": "0.1.0",
  "description": "Falcon-1024 (FIPS 206) keys and Algorand post-quantum accounts: keygen, deterministic sign/verify, and falcon_verify LogicSig address derivation. Standalone, runtime-agnostic.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/falcon.wasm": "./wasm/falcon.wasm"
  },
  "files": ["dist", "src", "wasm", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/falcon-module-factory.js dist/",
    "test": "node test/smoke.mjs"
  },
  "keywords": ["falcon", "falcon-1024", "pqc", "post-quantum", "fips-206", "algorand", "logicsig", "signature"],
  "license": "Apache-2.0",
  "author": "AlgoVoi",
  "dependencies": {
    "algosdk": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
